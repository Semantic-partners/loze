@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loze: <https://loze-ontology.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://loze-ontology.org/artefacts-information-and-instructions> a owl:Ontology ;
    rdfs:label "Artefacts, Information, and Instructions" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "An extension of loze-foundation.ttl pertaining to artefacts, information, and instructions" ;
    owl:imports loze: .

############################################
# Artefacts, Information, and Instructions #
############################################

loze:Artefact a owl:Class ;
    rdfs:label "Artefact" ;
    skos:definition "An object that is designed and made by humans for serving certain purposes or functions" ;
    skos:example "A vehicle, a hammer, an appliance, a duct, a glass, a house, a cloth, an electronic device, a fork, a software, an artwork" ;
    skos:note "Artefact can be either schematic or concrete: a software - in abstraction from its installed copies - is an artefact; a software's installed copies are also artefacts; a symphony - as a work of music, in abstraction from its performances - is also an artefact" ;
    rdfs:subClassOf loze:Object .

loze:InformationArtefact a owl:Class ;
    rdfs:label "Information Artefact" ;
    skos:definition "An artefact that consists of a structured system of symbols' occurrences meant to convey information" ;
    skos:example "A book, an article, a note, a document, a digital file, a computer programme or software" ;
    skos:note "The information carried by an information artefact does not need to be intelligible for humans: for example, certain files or codes carry information that is only meant to be executed by a machine" ;
    skos:note "An information artefact can be either a schematic object or a concrete object: War and Peace is schematic, whereas its copies are concrete; a PDF file is schematic, whereas its copies are concrete; a software is schematic, whereas its installed copies are concrete" ;
    skos:note "An information artefact that is concrete is always going to be the concretization of some schematic information artefact" ;
    rdfs:subClassOf loze:Artefact .

loze:Text a owl:Class ;
    rdfs:label "Text" ;
    skos:definition "An information artefact that consists of sentences in some human-readable language and is meant to convey meaning to humans" ;
    skos:example "A book, an article, a physical document, a text or document file, a book chapter, a dish recipe" ;
    skos:note "According to the definition, not only plain text files, but also document files are instances of loze:Text" ;
    skos:note "In a software system, a machine code might not be a text, because it's not always meant to convey meaning to humans; on the other hand, the source code is a text, since it's human-readable" ;
    rdfs:subClassOf loze:InformationArtefact . 

loze:isStandardIn a owl:ObjectProperty ;
    rdfs:label "is Standard In" ;
    skos:definition "The sub-relation of loze:isTopicIn that obtains when the topic provides the rules or standard for the performance of the eventuality" ;
    skos:example "Regulations are the standard in a compliant business operation, best practices are the standard in a technical development, the workflow is the standard in the execution of a technical process" ;
    skos:note "Only eventualities that have humans as agents (loze:isAgentIn) or are executed by objects designed by humans - like an automated system - can have a standard (loze:isStandardIn), since treating something as a rule or standard for an action requires human-like cognitive faculties" ;
    rdfs:domain loze:Particular ;
    rdfs:range loze:Eventuality ;
    rdfs:subPropertyOf loze:isTopicIn .

loze:hasStandard a owl:ObjectProperty ;
    rdfs:label "has Standard" ;
    skos:definition "The relation that obtains between an eventuality e and a particular p if and only if p is the standard in e" ;
    rdfs:domain loze:Eventuality ;
    rdfs:range loze:Particular ;
    owl:inverseOf loze:isStandardIn .

loze:isInstructionIn a owl:ObjectProperty ;
    rdfs:label "is Instruction In" ;
    skos:definition "The sub-relation of loze:isStandardIn that obtains when the standard in question is an information artefact consisting of instructions for performing the eventuality" ;
    skos:example "The assembly manual is the instruction in the assembly of a piece of furniture, the cookbook recipe is the instruction in the preparation of a cake, the workflow documentation is the instruction in the execution of a technical process, a computer programme or software is the instruction in a computational process or programme execution" ;
    rdfs:domain loze:InformationArtefact ;
    rdfs:range loze:Eventuality ;
    rdfs:subPropertyOf loze:isStandardIn .

loze:hasInstruction a owl:ObjectProperty ;
    rdfs:label "has Instruction" ;
    skos:definition "The relation that obtains between an eventuality e and an information artefact i if and only if i is the instruction in e" ;
    rdfs:domain loze:Eventuality ;
    rdfs:range loze:InformationArtefact ;
    owl:inverseOf loze:isInstructionIn .

loze:isRecipeIn a owl:ObjectProperty ;
    rdfs:label "is Recipe In" ;
    skos:definition "The sub-relation of loze:isInstructionIn that obtains when the instructions in question prescribes the ingredient ratio and/or doses and the procedure for producing concrete particulars of a certain type or with certain features" ;
    skos:example "The cookbook doses and instructions are the recipe in the preparation of a cake, a pharmaceutical formulation is the recipe in the production of paracetamol tablets, the alloy formula together with the alloying instructions are the recipe in the manufacturing of steel slabs" ;
    skos:note "Whenever an eventuality has a recipe (loze:isRecipeIn) among its participants, it will also have a product (loze:isProductIn), which will be a concrete particular" ;
    rdfs:domain loze:InformationArtefact ;
    rdfs:range loze:Eventuality ;
    rdfs:subPropertyOf loze:isInstructionIn .

loze:hasRecipe a owl:ObjectProperty ;
    rdfs:label "has Recipe" ;
    skos:definition "The relation that obtains between an eventuality e and an information artefact i if and only if i is the recipe in e" ;
    rdfs:domain loze:Eventuality ;
    rdfs:range loze:InformationArtefact ;
    owl:inverseOf loze:isRecipeIn .