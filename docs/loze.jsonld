[
  {
    "@id": "https://loze-ontology.org/hasInstruction",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Instruction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/InformationArtefact"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isInstructionIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and an information artefact i if and only if i is the instruction in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isAgentIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Thing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Agent In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a thing t and an eventuality e if and only if t acts or causes changes in some thing in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The killer is the agent in a killing, the mechanic is the agent in the repair of the car, Joe is the agent in Joe's walking, the baker is the agent in the making of the bread"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "A given thing can be both agent and patient in the same eventuality: for example, a person washing themselves is both agent and patient in a washing; in a handshake greeting, both persons are both agents (since they are shaking the other person's hand) and patient (since their own hand is being shaken)"
      },
      {
        "@value": "An eventuality can have an agent without having patients or products: for example, Joe's walking has Joe has agent, but no patient or product"
      },
      {
        "@value": "An agent doesn't need to be a person, a living being or some other object that we would intuitively consider 'animated' "
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isRepeatedContentIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Repeated Content In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Containment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isContentIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The sub-relation of loze:isContentIn that obtains whenever the content is a schematic particular that is repeated in the host in multiple occurrences"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "In the case of a blister pack containing 10 standardised 5 mg paracetamol tablets, the 5 mg paracetamol tablet - construed as a schematic particular - is the repeated content"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "A containment with a repeated component is always going to have an associated number of occurrences (loze:hasNumberOfOccurrences)"
      },
      {
        "@value": "While the repeated content is always going to be a schematic particular, the host can be either a schematic particular or a concrete particular"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isDeterminationOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#TransitiveProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Determination Of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a schematic particular x and another schematic particular y if and only if x has all the essential properties of y together with further essential properties that y lacks"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The Toyota Corolla Hatchback is a determination of the Toyota Corolla; the 1869 version of War and Peace is a determination of War and Peace; Apocalypse Now Redux is a determination of Apocalypse Now; heavy water is a determination of water; anthracite is a determination of coal; carbon-14 is a determination of carbon"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Informally, determination consists in the gradual increase in detailing and specificity of a schematic particular; it can be viewed as the schematic particulars' counterpart of subclasshood"
      },
      {
        "@value": "If x is a concretization of y and y is a determination of z, then x is also a concretization of z; one unit of the Toyota Corolla hatchback is also a unit of the Toyota Corolla; a heavy water molecule is a water molecule; and so on"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasHolder",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Holder"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Entity"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isHolderIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e' and an entity e if and only if e is the holder in e'"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isDestinationIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Destination In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and an eventuality e if and only if p is the terminal point of movement or change in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The arrival point in a travel, the distribution point in a utility supply, the buyer in a property conveyance"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The destination does not need to be a place, but it can be a thing or a period of time too"
      },
      {
        "@value": "The change in question does not need to be a movement, but it can be a qualitative or quantitative change too: for example, if an eventuality consists in one object becoming more similar to another one, the latter will be the destination"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasRecipient",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Recipient"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isRecipientIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is a recipient in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isParticipantIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Participant In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an entity e and an eventuality e' if and only if e' determines, modifies or qualifies e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A red apple participates in its redness; Socrates participates in his wisdom; two spouses participate in their marriage; a killer, the victim, and the gun all participate in a killing; Italy, Austria and Germany all participates in Austria being located between Italy and Germany"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Intuitively, the participants in an eventuality can be viewed as the entities that are involved in it or play some role in it"
      },
      {
        "@value": "There are various ways in which an entity can participate in an eventuality, which are expressed by means of various sub-relations of loze:isParticipantIn"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Entity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Entity"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "http://www.w3.org/2002/07/owl#Class"
          },
          {
            "@id": "https://loze-ontology.org/Particular"
          }
        ]
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Anything that exists, is real, or is in the world"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "It corresponds to owl:Thing"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isWaypointIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Waypoint In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and an eventuality e if and only if p is an intermediate point of movement or change in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "An intermediate stop in a travel, the ducts linking the supply point to a distribution point"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The destination does not need to be a place, but it can be a thing or a period of time too"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasStage",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Stage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isStageOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and an eventuality e' if and only if e' is a stage of e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isCompositeIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Composite In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Composition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and a composition c if and only if p has as component some other particular in the context of c"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "In my arm being part of my body, my arm is the component and my arm is the composite; in a heap of sand having an individual grain as part, the heap is the composite and the grain is the component; in the composition of water by hydrogen, water is the composite and hydrogen is the component"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Object",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Object"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A thing that is individuated by a certain internal organisation, function, or form"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A human, a horse, a molecule, a table, a computer, a planet, a paracetamol tablet"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "An object persists over time as long as it preserves the internal organisation, function, or form that individuates it; as long as that is preserved, the parts of the objects and their types can change without causing the object to go out of existence"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasTheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Theme"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isThemeIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is a theme in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasRepeatedComponent",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Composition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Repeated Component"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isRepeatedComponentIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a composition c and a schematic particular s if and only if s is the repeated component in c"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Plant",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Plant"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/LivingBeing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A living being that (i) is eukaryote - namely, has cells with a membrane-bound nucleus and organelles - and (ii) derives its nourishment from photosynthesis"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Within biological taxonomy - so-called Tree of Life - plants are the members of the kingdom of Plantae"
      },
      {
        "@value": "Plants typically have a firmer cellular structure than animals and are not able to move"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isReferencePointIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Reference Point In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and an eventuality e if and only if p is the term of reference point or the reference framework for a movement, change, or comparison in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "In the case of John being taller than Dan, Dan is the reference point; in the case of an object falling down from the top of a tower, the top of the tower is the reference point; in the case of a vehicle moving on the surface of Earth, Earth - or some Earth-based geolocation framework - is the reference point"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The possibility of absolute motion is controversial in theoretical physics and philosophy; however, this matter is operationally irrelevant, because in practice motion can only be assessed relative to a reference framework"
      },
      {
        "@value": "The scope of this thematic relation is not limited to motion, but also encompasses other types of changes as well as comparisons: for example, if an eventuality consists in an object being larger than another one, the larger object will be the theme and the other will be the reference point"
      },
      {
        "@value": "In ordinary talk, the reference point of a movement is often not mentioned because it's identified by default with the Earth - or some Earth-based reference framework"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isIngredientIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Substance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Ingredient In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Composition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isComponentIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The sub-relation of loze:isComponentIn that obtains whenever the component is a substance that occurres in the composite in a given amount"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "In the case of a cake having as ingredient 200 grams of wheat flour, wheat flour is the ingredient; in the case of a solution having as ingredient 2 litres of water, water is the ingredient"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Substance repetition is impractical to account for in terms of number of occurrences, since the units are too many to be counted; consequently, instead of using loze:hasNumberOfOccurrences, it is advisable to specify quantities based on units of measure"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Composition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Composition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://loze-ontology.org/Parthood"
          },
          {
            "@id": "https://loze-ontology.org/Constitution"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An eventuality that is either a parthood or a constitution"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasHost",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Host"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isHostIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is the host in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasCause",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Cause"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isCauseOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and an eventuality e' if and only if e' is a cause of e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Substance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Substance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A schematic particular that is highly dissectable"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "Copper, gold, water, wood, kerosene, steel, wheat flour, sugar, liquid acrylic paint"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Dissectability consists in concretizations being iteratively divisible into parts of the same kind: a mass of water can be divided into other masses of water; a chunk of wood can be further divided into other chunks of wood; a piece of gold can be divided into smaller pieces of gold; and so on. Despite the appearence of infinite divisibility, we know from chemistry that this dissectability is going to stop at either the molecular or the atomic level: for example, a water molecule has no smaller parts that are themselves water, and an atom of gold has no smaller parts that are themselves gold"
      },
      {
        "@value": "Here the word 'substance' is used in the chemical sense, and not in the metaphysical sense - which originated in ancient Greek philosophy and is still used in contemporary analytic metaphysics"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasHeld",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Held"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Entity"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isHeldIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e' and an entity e if and only if e is held in e'"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/throughoutTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "throughout Time"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/PeriodOfTime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a period t if and only if e occurs starting from the beginning of t until and until the end of t"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "WWII occurred throughout the 1939-1945 period, the Thirty Years' War occurred throghout the 1618-1648 period, Napoleon's life occurred throughout the 1769-1821 period"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The function of this relation is to specify the temporal location of an eventuality as a whole"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isHolderIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Holder In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an entity e and an eventuality e' if and only if e controls or is super-ordinated to some other entity in the context of e' "
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "the person or organisation is the holder in a possession or ownership; the manager is the holder in a management relationship with the managed employee"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Aggregate",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Aggregate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A thing that is individuated by some stable material composition or spatial contiguity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A chunk of wood, a waterbody, the liquid contained in a tank, a heap of sand, the global petrol supply"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "An aggregate can also be scattered across space - such as the total water reserve of England or the amount of methane used for heating my house over the last year - in which case its individuation is based on a combination of material composition and practical interests"
      },
      {
        "@value": "Objects are also typically material, but aggregates differ from objects because they are not unified by an internal organisation, function or form"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isSettingIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Object"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Setting In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an object o and an eventuality e if and only if o is the setting or context in which e is the case"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The organisation is the setting of a presidency, a living being is the setting in which an organ is vital, a wall is a partition in a house"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Only objects can be settings, since they are the only particulars that have the sort of hierarchical structure in which something can occupy a role or function"
      },
      {
        "@value": "This thematic relation is intended for those eventualities that consist in roles, positions, or functions within a setting or an organised system; the participant that occupies the role is a theme in the eventuality"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/atTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "at Time"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/PeriodOfTime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a period of time t if and only if e is the case or is occurring at t"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "WWII was happening at 1943, the French Revolution was happening at 1790, the Italian Renaissance was happening at 1513"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "This relation doesn't necessarily relate an eventuality to the entire period of time when it occurs; for example, WWII started in 1939 and ended in 1945, but it was still in course in 1943, so it entertains the relation loze:atTime with 1943 too"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasNumberOfOccurrences",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Number Of Occurrences"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that assignes to an eventuality the number of occurrences in which a certain schematic particular is repeated in the context of that eventuality"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "In a composition in which a polymerous sequence has a monomer repeated 3000 times, the number of occurrences is 3000; in the composition of the water molecule out of hydrogen, the number of occurrences is 2; in a containment in which a tablet is repeated 10 times in a blister pack, the number of occurrences is 10"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "This relation is mostly intended to be used in the context of compositions (loze:Composition) and containments (loze:Containment); that being said, its application to other eventualities should not be excluded in principle"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Constitution",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Constitution"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Composition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An eventuality that consists in one particular being entirely made up by repeated occurrences of a given schematic particular"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A polymerous sequence being made up by repetitions of a given monomer; an aggregate of tablets being made up by one tablet (construed as a schematic object) repeated in 10 occurrences"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "In formal mereology, one particular being 'entirely made up' by repeated occurrences, means that it is identical to the mereological sum of those occurrences: as an approximation, this means that its only parts are those occurrences and the parts of those occurrences; more rigorous definitions can be found in the philosophical literature on formal mereology"
      },
      {
        "@value": "In a constitution, the core participants are the composite (loze:isCompositeIn) and the schematic particular that is repeated in it (loze:isComponentIn)"
      },
      {
        "@value": "In practice, the function of this class of eventualities is to describe the overall composition of a particular without giving an enumeration of its individual parts"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Person",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Person"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Animal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An animal that is a specimen of the species Homo sapiens"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "It does not encompass those entities that in the legal jargon are called 'legal persons' or 'non-physical persons' "
      },
      {
        "@value": "Specimens of other species of the genus Homo (such as Homo erectus or Homo Neanderthalensis) would be problematic to categorise, because they are not specimens of Homo sapiens yet they qualify as humans in a broader sense; in practice, this issue is irrelevant, since Homo sapiens is the only extant species of the genus Homo"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasAgent",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Thing"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isAgentIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a thing t if and only if t is an agent in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasDestination",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Destination"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isDestinationIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is the destination in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/artefacts-information-and-instructions",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Artefacts, Information, and Instructions"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://loze-ontology.org/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An extension of loze.ttl with classes and predicates related to artefacts, information artefacts, and instructions"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isRecipeIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/InformationArtefact"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Recipe In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isInstructionIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The sub-relation of loze:isInstructionIn that obtains when the instructions in question prescribes the ingredient ratio and/or doses and the procedure for producing concrete particulars of a certain type or with certain features"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The cookbook doses and instructions are the recipe in the preparation of a cake, a pharmaceutical formulation is the recipe in the production of paracetamol tablets, the alloy formula togethet with the alloying instructions are the recipe in the manufacturing of steel slabs"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Whenever an eventuality has a recipe (loze:isRecipeIn) among its participants, it will also have a product (loze:isProductIn), which will be a concrete particular"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isHostIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Host In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and an eventuality e if and only if p encloses, accommodates or contains some other particular in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The house is the host in a residency or occupation, the tank is the host in the containment of a liquid, the duct is the host in the flow of a fluid, the place is the host in a position or location"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "This relation does not apply to a person who is 'hosting' a party or to the 'host' of a game - who are rather agents in the respective eventualities"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/materials-and-composition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Materials and Composition"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://loze-ontology.org/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An extension of loze.ttl with classes and relations for modelling substances and material composition"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/fromTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "from Time"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/PeriodOfTime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a period of time t if and only if e starts occurring at t"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "WWII occurred from 1939, the Thirty Years' War occurred from 1618, Napoleon's life occurred from 1769"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isBeneficiaryIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Beneficiary In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and an eventuality e if and only if p benefits from what happens in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "People with cancer are the beneficiaries in a donation to cancer research, a household is the beneficiaty in an allocation of subsidies for energy upgrades work to a company"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "In some cases, the beneficiary of an eventuality is the same as the patient: for example, the beneficiary of successful a medication, therapy, or surgical operation is the patient"
      },
      {
        "@value": "The beneficiary is often going to be the recipient too, but there are exceptions; consider a case in which a household is awarded a grant for the energy upgrade of their house, and the grant is paid to an energy upgrade company: in that scenario, the company is the recipient of the grant, but the household is the beneficiary"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasComposite",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Composition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Composite"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isCompositeIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a composition c and a particular p if and only if p is the composite in c"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasDetermination",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Determination"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isDeterminationOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a schematic particular x and a schematic particular y if and only if y is a determination of x"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/suggested-social-extension",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Suggested Social Extension"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://loze-ontology.org/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An extension of loze.ttl with classes and relations for modelling living beings and social entities such as persons, groups, and organisations"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isHeldIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Held In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isThemeIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an entity e and an eventuality e' if and only if e is controlled by or subordinated to some other entity in the context of e' "
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The possessed thing is the held in a possession or ownership; the managed employee is the held in a management relationship"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/beforeTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "before Time"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/PeriodOfTime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a period of time t if and only if e occurs entirely before t"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "WWII occurred before 1960, the birth of Napoleon occurred before 1800"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The relation obtains even if the eventuality does not occur right before the period of time: for example, WWII occurred before 1970, even though over two decades passed between the end of WWII and 1970"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/OrganisationOrgan",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Organisation Organ"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Group"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A group that (i) is part of an organisation, (ii) it serves a specific function in the organisation in question, and (iii) it not itself an organisation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A government's parliament, a company's committee, a team"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The difference between an organisation organ and an organisation that is part of another organisation is that the official goals of an organ are entirely subordinated to those of the organisation of which it is part; by contrast, an organisation can maintain its own goals despite being part of a larger organisation"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Thing",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Thing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "https://loze-ontology.org/Object"
          },
          {
            "@id": "https://loze-ontology.org/Aggregate"
          },
          {
            "@id": "https://loze-ontology.org/Place"
          },
          {
            "@id": "https://loze-ontology.org/PeriodOfTime"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A particular entity that is not a way of being or a modification of other entities"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Despite the similar local name, this class is much narrower than owl:Thing, which encompasses all entities"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/PeriodOfTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Period Of Time"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A thing that is individuated by its coordinates across the temporal axis"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The year 1943, the 6th of May of 2005, any second or minute, the period that goes from the 3rd of May of 1467 to the 22nd of July of 1615"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Two period of time can have exactly the same duration and yet be distinct period of time, because they have distinct beginnings and ends; for example, this hour and the next hour are two distinct periods, despite having the exact same duration of 60 minutes"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Group",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Object"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An object that consists of persons that are associated to each other by some socially significant relation or recurrent interaction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A household, a family, a couple, any organisation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Groups don't include collections of persons who merely happen to have a common feature - such as the men, the persons with blonde hair, or the graduates - unless those persons also happen to be organised together or to interact with each other on a regular basis; such collections are best modelled as classes"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/ConcreteParticular",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Concrete Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A particular that is bounded to one spatial location at a time"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "Your arm, one Toyota Corolla unit, the computer in front of you, the portion of water in a given glass, a piece of gold, one performance of Beethoven's Symphony No 9, the stabbing of Caesar from Brutus, a heap of sand, your bedroom, the last hour"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Differently from Schematic particulars, a concrete particular only occupies one place or location at a time: my copy of War and Peace occupies one slot in my bookcase right now; I can only occupy one place at a time; a unit of Toyota Corolla is in one place at a time; a particular performance of Beethoven's Symphony No 9 takes place in one and only one venue"
      },
      {
        "@value": "The distinction between concrete particulars and schematic particulars cuts across all the other divisions of the class :Particular: there are concrete objects and schematic objects, concrete eventualities and schematic eventualities, concrete aggregates and schematic aggregates, and so on"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isRecipientIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Recipient In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and an eventuality e if and only if some other particular is transferred or put under the hold of p in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The payee is the recipient in a payment, the buyer is the recipient in a property conveyance, the addressee is the recipient in a shipping, the donee is the recipient in a donation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Compared to an affected thing, the recipient is impacted or controlled less directly in the context of the eventuality"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasInstrument",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Instrument"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isInstrumentIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is an instrument in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/InformationArtefact",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Information Artefact"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Artefact"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An artefact that consists of a structured system of symbols' occurrences meant to convey information"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A book, an article, a note, a document, a digital file, a computer programme or software"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "An information artefact that is concrete is always going to be the concretization of some schematic information artefact"
      },
      {
        "@value": "The information carried by an information artefact does not need to be intelligible for humans: for example, certain files or codes carry informaton that is only meant to be executed by a machine"
      },
      {
        "@value": "An information artefact can be either a schematic object or a concrete object: War and Peace is schematic, whereas its copies are concrete; a PDF file is schematic, whereas its copies are concrete; a software is schematic, whereas its installed copies are concrete"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Place",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Place"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Thing"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A thing that is individuated by its position relative to other things - such as being enclosed by an object, being to the left side of an object, or being immediately North of another place"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A room, the interior of a refrigerator, a tunnel, the left ventricle of your heart"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The matter that is hosted in a place makes no difference for the individuation of that place: a room remains in existence irrespective of whether it hosts an absolute vacuum, a few pieces of furniture and regular air, or a giant load of cotton wool"
      },
      {
        "@value": "There is an obvious sense in which even objects can host other particulars: for example, a house can host people and artefacts; likewise, a tank can host amounts of liquid; however, places host things by being occupied by them, whereas objects host things by having them within themselves - that is, by having them occupying the place that they enclose"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Eventuality",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A particular entity that is a way of being or a modification of one or more other entities - qualifying them or making them be or go in a certain way - and is individuated by those entities"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The redness of this apple, the wisdom of Socrates, the marriage between Napoleon and Josephine, the stabbing of Caesar from Brutus, my walk from my house to a grocery shop, the Earth being positioned between Venus and Mars, an engine being fuelled with an amount of gasoline"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "An eventuality is not general, but is linked to its participants - that is, the entities that bear it or are involved in it; the wisdom of Socrates is numerically distinct from the wisdom of Diogenes, and they existed at different times; the redness of this apple is distinct from the redness of that other apple, and so on"
      },
      {
        "@value": "This is intended as a broad, comprehensive category that encompasses the entities that in other ontologies and category systems are variously called 'qualities', 'attributes', 'relations, 'events', 'processes', 'facts', 'specifically dependent continuants' etc..."
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasStandard",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Standard"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isStandardIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is the standard in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasRepeatedContent",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Containment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Repeated Content"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isRepeatedContentIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a containment c and a schematic particular s if and only if s is the repeated content in c"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isTopicIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Topic In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an entity e and an eventuality e' if and only if e is a subject matter of cognition or meaning in the context of e' "
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "Joe is the topic in an identity check, an electrical system is the topic of an electrical safety report, cancer (as a schematic particular or a class of eventualities) is the topic in a cancer research, liberty is the topic of John Stuart Mill's essay 'On Liberty', a book (in abstraction from its copies) is the topic of a review"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Since a cognition can be about abstractions, the topic of an eventuality can also be a class or a schematic particular"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/afterTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "after Time"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/PeriodOfTime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a period of time t if and only if e occurs entirely after t"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "WWII occurred after 1900, the birth of Napoleon occurred after 1700, "
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The relation obtains even if the eventuality does not occur immediately after the period of time: for example, WWII occurred after 1900, even though it only started in 1939"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasSetting",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Setting"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Object"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isSettingIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and an object o if and only if o is the setting in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasTopic",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Topic"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Entity"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isTopicIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e' and an entity e if and only if e is a topic in e'"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasParticipant",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Participant"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Entity"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e' and an entity e if and only if e is a participant in e'"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isRepeatedComponentIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Repeated Component In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Composition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isComponentIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The sub-relation of loze:isComponentIn that obtains whenever the component is a schematic particular that is repeated in the composite in multiple occurrences"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "In the case of a monomer making up a polymerous sequence, the monomer is the repeated component; in the case of water having two atoms of hydrogen, hydrogen atom is the repeated component; in the case of an engine having pistons of a certain type, the piston - construed as a schematic object - is the repeated component"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "While the repeated component is always going to be a schematic particular, the composite can be either a schematic particular or a concrete particular"
      },
      {
        "@value": "The number of repetitions is going to be specified by the associated number of occurrences (loze:hasNumberOfOccurrences)"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isThemeIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Theme In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and an eventuality e if and only if p is in a certain state or occupies a position in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "In a marriage, both spouses are themes; in the case of a glass lying on a table, the glass is the theme; in the case of an amount of liquid contained in a tank, the amount of liquid is the theme; in the case of somebody owning a real estate, the real estate is theme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "That of the theme is a broad thematic relations that can be useful whenever no other thematic relation applies; that being said, more specific sub-relations should be defined whenever needed"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isStageOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Stage Of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between two eventualities e and e' if and only if e is a stage or phase in the occurrence of e' "
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The construction of the foundations of a house is a stage of the construction of the whole house, the preparation of the dough is a stage in the making of a pizza, the positioning of the explosive is a stage in the demolition of a building, the fermentation of the must is a stage in the production of wine"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Given an eventuality e and a period of time t, e can have at the most one stage that occurs from the start to the end of t"
      },
      {
        "@value": "In other upper-level ontologies, relations like this are considered special cases of parthood, since the stages of an eventuality can be viewed as its 'temporal slices'; however, we prefer to suspend the judgment about whether the stages of an eventuality are to be considered among its parts"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/withinTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "within Time"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/PeriodOfTime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains betwen an eventuality e and a period of time t if and only if e occurs throughout a a sub-period of t"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "WWII occurred within the XX century, the Thirty Years' War occurred within the 1620-1650 period, the Italian Renaissance occurred within the second millenium"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isOriginIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Origin In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular entity p and an eventuality e if and only if p is the initial point of a movement or change in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The starting point in a journey, the supply point in a utility supply, the seller in a property conveyance, the seed in a plant growth"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The origin does not need to be a place, but it can be a thing or a period of time too"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/NonHumanAnimal",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Non-Human Animal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Animal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An animal that is not a specimen of the species Homo sapiens"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "In ordinary talk as well as legal talk, non-human animals are usually called just 'animals'"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/SchematicParticular",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Schematic Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A particular that is not bounded to one spatial location at a time and that can be concretized by concrete particulars"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A document (as opposed to its particular copies), a work of music (as opposed to its performances), an alphabetic character (as opposed to its inscriptions), a software (as opposed to its installed copies), a substance or material like water or gold (as opposed to their circumscribed portions), a car model (as opposed to its units)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Similarly to classes, schematic particulars are not bounded to one particular location at a time: as a rule, a schematic particular is wholly present wherever one of its concretizations is present; War and Peace is present wherever one of its copies is present; water is present wherever one or more H2O molecules are present; the Toyota Corolla is present wherever one of its units is present"
      },
      {
        "@value": "An schematic particular has the force of a determinant with regard to its concretizations: the structure of Beethoven's Symphony No 9 dictates the structure of its performances; the specifications of the Toyota Corolla are the benchmark for the features of its units; the chemical properties of water determine the behaviour of concrete portions of water"
      },
      {
        "@value": "The division between concrete particulars and schematic particulars cuts across the further sub-divisions of particulars: there are concrete objects and schematic objects, concrete eventualities and schematic eventualities, concrete aggregates and schematic aggregates, and so on"
      },
      {
        "@value": "Differently from classes, schematic particulars share their main features with their instances; for example, a book has chapters just like its copies, a piece of music has the same harmonic structure as its performances, an alphabetic character has the same shape as its inscriptions, a car model has similar features as its units"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isInstrumentIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Instrument In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and an eventuality e if and only if p enables an agent to affects some thing in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The gun is the instrument in a killing, the hammer is the instrument in the driving of a nail, the vehicle is the instrument in a journey, a debit or credit card is the instrument in a payment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The instrument in an eventuality can also be a person: for example, the messenger is the instrument in the sending of a message"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/LivingBeing",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Living Being"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Object"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An object that displays properties such as responsiveness, growth, metabolism, energy transformation, and reproduction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The precise definition of life and living being is controversial in philosophy of science and theoretical biology; still, the marks described in our definition are normally sufficient for assessing whether an object is a living being or not; nevertheless, there are still borderline cases, such as viruses and so-called super-organisms (e.g. coral colonies and bacterial biofilms)"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isContentIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Content In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isThemeIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and an eventuality e if and only p is enclosed or contained by some other particular in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The liquid is the content in its containment by a tank, the fluid is the content when flowing in a duct"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/PlaceOccupation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Place Occupation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An eventuality that consists in one particular entity occupying a place partly or entirely"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A carrot occupying the interior of a refrigerator, a sofa occupying a living room, an amount of liquid occupying the interior of a tank"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "In a place occupation, the host is always a place, rather the object enclosing it - say, the interior of a refrigerator, rather than the refrigerator itself"
      },
      {
        "@value": "The core participants in a place occupation are the place (:isHostIn) and the particular entity that occupies it (:isHostedIn)"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasOrigin",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Origin"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isOriginIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is the origin in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Containment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An eventuality in which a particular is positioned within and physically constrained by another object"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Containment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A box containing eggs, a glass containing a portion of water, a dwelling containing pieces of furniture"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "In a containment, the core participants are the container (loze:isHostIn) and the content (loze:isContentIn)"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isCauseOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Cause Of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between two eventualities e and e' if and only if the occurrence of e contributes to make e' occur"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "A simple, informal test for assessing whether an eventuality e is cause of another eventuality e' is to ask whether e'occurs (also) because of e, or whether the occurrence of e' is explained (among the other things) by the occurrence of e; if the answer is affirmative, then e entertains loze:isCauseOf with e' "
      },
      {
        "@value": "Multiple eventualities can entertain the relation :isCauseOf with a given eventuality, since an eventuality can have more than one cause"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isProductIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Product In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and an eventuality e if and only if p is brought into existence by some other particular in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The house is the product in a construction work, the cake is the product in the context of baking, molecules are the products in a chemical synthesis, the zygote is the product in the fertilization of a female gamete from a male gamete"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Every eventuality that has a product also has some agent"
      },
      {
        "@value": "A product does not need to be a concrete particular, but it can also be a schematic particular: for example, a document or a book (in abstraction from its copies) is the product of a writing endeavour"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasWaypoint",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Waypoint"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isWaypointIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is a waypoint in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isSubPeriodOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/PeriodOfTime"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Sub-Period Of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/PeriodOfTime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between two periods of time of which the former is a part or segment of the latter"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The year 1969 is a sub-period of the XX century, the period 1740-1751 is a sub-period of the period 1740-1789, the June of 1816 is a sub-period of the year 1816"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Parthood",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Parthood"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Composition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An eventuality that consists in one particular being part of another particular"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "An arm being part of a person, a wall being part of a house, a compressor being part of a refrigerator, a wood board being part of a table, a nucleus being part of an atom, Mars being part of the solar system, the lithosphere being part of the Earth, a movement being part of symphony, hydrogen atom being part of water molecule"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The core participants in a parthood are the part (loze:isComponentIn) and the composite (loze:isCompositeIn)"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasRecipe",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Recipe"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/InformationArtefact"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isRecipeIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and an information artefact i if and only if i is the recipe in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isComponentIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Component In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Composition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a particular p and a composition c if and only if p composes some other particular in the context of c"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "In my arm being part of my body, my arm is the component and my body is the composite; in a heap of sand having an individual grain as part, the heap is the composite and the grain is the component; in the composition of water by hydrogen, water is the composite and hydrogen is the component"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasReferencePoint",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Reference Point"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isReferencePointIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is the reference point in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Artefact",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Artefact"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Object"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An object that is designed and made by humans for serving certain purposes or functions"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A vehicle, a hammer, an appliance, a duct, a glass, a house, a cloth, an electronic device, a fork, a software, an artwork"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Artefact can be either schematic or concrete: a software - in abstraction from its installated copies - is an artefact; a software's installed copies are also artefacts; a symphony - as a work of music, in abstraction from its performances - is also an artefact"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasIngredient",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Composition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Ingredient"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Substance"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isIngredientIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a composition c and a substance s if and only if s is the ingredient in c"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Text",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Text"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/InformationArtefact"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An information artefact that consists of sentences in some human-readable language and is meant to convey meaning to humans"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A book, an article, a physical document, a text or document file, a book chapter, a dish recipe"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "In a software system, a machine code might not be a text, because it's not always meant to convey meaning to humans; on the other hand, the source code is a text, since it's human-readable"
      },
      {
        "@value": "According to the definition, not only plain text files, but also document files are instances of loze:Text"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/temporal-relations",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Temporal Relations"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://loze-ontology.org/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An extension of loze.ttl with relations for locating eventualities relative to periods of time"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasBeneficiary",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Beneficiary"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isBeneficiaryIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is a beneficiary in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasProduct",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Product"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isProductIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is a product in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasComponent",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Composition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Component"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isComponentIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a composition c and a particular p if and only if p is a component in c"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isStandardIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Standard In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isTopicIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The sub-relation of loze:isTopicIn that obtains when the topic provides the rules or standard for the performance of the eventuality"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "Regulations are the standard in a compliant business operation, best practices are the standard in a technical development, the workflow is the standard in the execution of a technical process"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Only eventualities that have humans as agents (loze:isAgentIn) or are executed by objects designed by humans - like an automated system - can have a standard (loze:isStandardIn), since treating something as a rule or standard for an action requires human-like cognitive faculties"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isConcretizationOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/ConcreteParticular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Concretization Of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a concrete particular c and a schematic particular s if and only if (1) c exemplifies or has the main features of s, and (2) s provides the benchmark or the norm for the properties and the behaviour of c"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The concretizations of War and Peace are its copies, the concretizations of Beethoven's Symphony No 9 are its performances, the concretizations of Sachertorte are the individual Sachertorte, the concretizations of a software are its installed copies, the concretizations of the Toyota Corolla (as a car model) are its manufactured units"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Concretization enables schematic particulars to be located vicariously, by being located where their concretizations are; in general, a schematic particular is wholly present wherever one of its concretizations is present; since it can have multiple concretizations at the same time, a schematic particular can be located in multiple places at the same time"
      },
      {
        "@value": "The concretizations of a schematic particular can deviate from it in various respects: for example, most performances of Beethoven's Symphony No 9 typically lasts between 65 and 75 minutes, but the 2018 performance from the Philarmonia Orchestra conducted by Benjamin Zander only lasts 58 minutes; in some cases, the deviation is merely an anomaly, but in other cases it entails that the concretization is defective, faulty, or bad, like a poorly made Sachertorte, or a faulty Toyota Corolla unit"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasContent",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Content"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Particular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isContentIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a particular p if and only if p is the content in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasAffected",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Affected"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Thing"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isAffectedIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a thing t if and only if t is affected in e"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isInstructionIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/InformationArtefact"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Instruction In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isStandardIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The sub-relation of loze:isStandardIn that obtains when the standard in question is an information artefact consisting of instructions for performing the eventuality"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The assembly manual is the instruction in the assembly of a piece of furniture, the cookbook recipe is the instruction in the preparation of a cake, the workflow documentation is the instruction in the execution of a technical process, a computer programme or software is the instruction in a computational process or programme execution"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Animal",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Animal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/LivingBeing"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "https://loze-ontology.org/Person"
          },
          {
            "@id": "https://loze-ontology.org/NonHumanAnimal"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A living being that (i) is eukaryote - namely, has cells with a membrane-bound nucleus and organelles - and (ii) is heterothropic - that is, derives its nourishment from the consumption of other living beings"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Animals typically have a more flexible body than plants and fungi and are able to move"
      },
      {
        "@value": "Within biological taxonomy - so-called Tree of Life - animals are the members of the kingdom of Animalia"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Organisation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Organisation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Group"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A group whose members are acting together in the pursuit of a common goal, based on an agreed upon system of rules and commitments"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "A company, a charity or foundation, a political party, a club, a state or government, an international organisation, a criminal gang, a terrorist organisation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "A group does not need to be legally registered or recognised to qualify as an organisation; in fact, there are organisations that are inherently illegal, such as criminal gangs and terrorist organisations"
      },
      {
        "@value": "An organisation can have other organisations as parts: for example, a company can have other companies - its subsidiaries - as parts"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/hasConcretization",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/SchematicParticular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has Concretization"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/ConcreteParticular"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://loze-ontology.org/isConcretizationOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a schematic particular s and a concrete particular c if and only if c is a concretization of s"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/untilTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "until Time"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/PeriodOfTime"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between an eventuality e and a period of time t if and only if e ends at t"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "WWII occurred until 1945, the Thirty Years' War occurred until 1648, Napoleon's life occurred until 1821"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/Particular",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Particular"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://loze-ontology.org/Entity"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointUnionOf": [
      {
        "@list": [
          {
            "@id": "https://loze-ontology.org/Thing"
          },
          {
            "@id": "https://loze-ontology.org/Eventuality"
          }
        ]
      },
      {
        "@list": [
          {
            "@id": "https://loze-ontology.org/SchematicParticular"
          },
          {
            "@id": "https://loze-ontology.org/ConcreteParticular"
          }
        ]
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An entity that is not a class or type of entities"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Particular entities are to be contrasted with classes; the concept of a particular mostly corresponds to the Semantic Web concept of an individual or instance"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/isAffectedIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://loze-ontology.org/Thing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "is Affected In"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://loze-ontology.org/Eventuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://loze-ontology.org/isParticipantIn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The relation that obtains between a thing t and an eventuality e if and only t is affected by a thing - the agent - in the context of e"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "The victim is affected in a killing, the cake is affected in an eating, the car is affected in the repair, the house is affected in an alteration"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Every eventuality that has an affected thing also has some agent"
      },
      {
        "@value": "A given thing can be both agent and affected in the same eventuality: for example, a person washing themselves is both agent and the affected thing in a washing; in a handshake greeting, both persons are both agents (since they are shaking the other person's hand) and affected (since their own hand is being shaken)"
      }
    ]
  },
  {
    "@id": "https://loze-ontology.org/",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Loze Upper-Level Ontology"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A top-level ontology largely inspired - with a few deviations and additions - by the four-category ontology outlined by the philosopher E. J. Lowe (2006), supplemented with the concept of a schematic particular explored by Eddy Zemach (1970)"
      }
    ]
  }
]