    <rdf:first rdf:resource="https://loze-ontology.org/Parthood" />
    <rdf:rest rdf:nodeID="cb1006a4431df6a00fffd2d4d88b363953b9df3f901a6fa32824773d2972dc733bd" />
  </rdf:Description>
