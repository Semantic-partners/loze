_:cbd7c96744b860be374134b6eeace4a6009e3d5947219e59b3c009836ad1012775 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:cbe5a1ad522aaffaca47d3ebe78e2851770e4e4ec5c5e7b1340ec3d90610a8cd85 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> <https://loze-ontology.org/Person> .
_:cbe5a1ad522aaffaca47d3ebe78e2851770e4e4ec5c5e7b1340ec3d90610a8cd85 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:cbd7c96744b860be374134b6eeace4a6009e3d5947219e59b3c009836ad1012775 .
