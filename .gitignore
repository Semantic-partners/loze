__pycache__/
*.pyc
.DS_Store

# Per-machine editor and agent config. These carried one developer's home paths
# into a shared repo — the same problem as an ontology file picking up a
# workspace:/// prefix, or a stylesheet naming a local skills folder as its
# source of truth. Nothing here is portable, so nothing here is shared.
.claude/
.vscode/
.idea/

# Build output. `python3 scripts/build.py` regenerates every file in here from
# the .ttl, so tracking it put ~1800 lines of machine-written HTML into a diff
# whose hand-written part was a fraction of that, and made every branch collide
# on files no one edits. The Turtle is the source; docs/ is a view of it.
docs/

# pele, installed by hand to render diagrams/. See scripts/diagrams.mjs.
node_modules/
