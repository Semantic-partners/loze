@prefix : <workspace:///suggested-social-extension.ttl#> .
@prefix loze: <http://loze-upper-level-ontology.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://loze-upper-level-ontology.org/suggested-social-extension> a owl:Ontology ;
    rdfs:label "Suggested Social Extension" ;
    skos:definition "An extension of loze-foundation.ttl pertaining to the social domain" ;
    skos:note "Among the other things, this extension includes a minimal taxonomy of living beings, which not even remotely expected to replicate the richness and depth of a full biological taxonomy - the so-called Tree of Life; if needed, the present taxonomy could be dramatically expanded" ;
    owl:imports loze: .

################
# Core classes #
################

loze:LivingBeing a owl:Class ;
    rdfs:label "Living Being" ;
    skos:definition "An object that displays properties such as responsiveness, growth, metabolism, energy transformation, and reproduction" ;
    skos:note "The precise definition of life and living being is controversial in philosophy of science and theoretical biology; still, the marks described in our definition are normally sufficient for assessing whether an object is a living being or not; that being said, there are a few borderline cases, such as viruses and so-called super-organisms (e.g. coral colonies and bacterial biofilms)" ;
    rdfs:subClassOf loze:Object .

loze:Animal a owl:Class ;
    rdfs:label "Animal" ;
    skos:definition "A living being that (i) is eukaryote - namely, has cells with a membrane-bound nucleus and organelles - and (ii) is heterotrophic - that is, derives its nourishment from the consumption of other living beings" ; 
    skos:note "Animals typically have a more flexible body than plants and fungi and are able to move" ;
    skos:note "Within the taxonomy of living beings - so-called Tree of Life - animals are the members of the kingdom of Animalia" ;
    rdfs:subClassOf loze:LivingBeing ;
    owl:disjointUnionOf (loze:Person loze:NonHumanAnimal) .

loze:Plant a owl:Class ;
    rdfs:label "Plant" ;
    skos:definition "A living being that (i) is eukaryote - namely, has cells with a membrane-bound nucleus and organelles - and (ii) derives its nourishment from photosynthesis" ;
    skos:note "Plants typically have a firmer cellular structure than animals and are not able to move" ;
    skos:note "Within the taxonomy of living beings - so-called Tree of Life - plants are the members of the kingdom of Plantae" ;
    rdfs:subClassOf loze:LivingBeing .

loze:Person a owl:Class ;
    rdfs:label "Person" ;
    skos:definition "An animal that is a specimen of the species Homo sapiens" ;
    skos:note "It does not encompass those entities that in the legal jargon are called 'legal persons' or 'non-physical persons' " ;
    skos:note "Specimens of other species of the genus Homo (such as Homo erectus or Homo Neanderthalensis) would be problematic to categorise, because they are not specimens of Homo sapiens yet they qualify as humans in a broader sense; in practice, this issue is irrelevant, since Homo sapiens is the only extant species of the genus Homo" ;
    rdfs:subClassOf loze:Animal .

loze:NonHumanAnimal a owl:Class ;
    rdfs:label "Non-Human Animal" ;
    skos:definition "An animal that is not a specimen of the species Homo sapiens" ;
    skos:note "In ordinary talk as well as legal talk, non-human animals are usually called just 'animals'" ;
    rdfs:subClassOf loze:Animal .

loze:Group a owl:Class ;
    rdfs:label "Group" ;
    skos:definition "An object that consists of persons that are associated to each other by some socially significant relations or recurrent interactions" ;
    skos:example "A household, a family, a couple, any organisation" ;
    skos:note "Groups don't include collections of persons who merely happen to have a common feature - such as the men, the persons with blonde hair, or the graduates - unless those persons also happen to be organised together or to interact with each other on a regular basis; if needed, such collections are best modelled as classes" ;
    rdfs:subClassOf loze:Object .

loze:Organisation a owl:Class ;
    rdfs:label "Organisation" ;
    skos:definition "A group whose members are acting together in the pursuit of one or more common goals, based on an agreed upon system of commitments and rules" ;
    skos:example "A company, a charity or foundation, a political party, a club, a state or government, an international organisation, a criminal gang, a terrorist organisation" ;
    skos:note "A group does not need to be legally registered or recognised to qualify as an organisation; in fact, there are organisations that are illegal by definition, such as criminal gangs and terrorist organisations" ;
    skos:note "An organisation can also have other organisations as parts: for example, a company can have other companies - its subsidiaries - as parts, and an international organisation can have governments as parts" ;
    rdfs:subClassOf loze:Group .

loze:OrganisationSubdivision a owl:Class ;
    rdfs:label "Organisation Subdivision" ;
    skos:definition "A group that (i) is part of an organisation, (ii) it serves a specific function in the organisation in question, and (iii) it not itself an organisation" ;
    skos:example "A government's parliament, a company's committee, a team" ;
    skos:note "The difference between an organisation subdivision and an organisation that is part of another organisation is that the official goals of a subdivision are entirely subordinated to those of the organisation of which it is part; by contrast, an organisation can maintain its own goals despite being part of a larger organisation" ;
    rdfs:subClassOf loze:Group .

loze:Actor a owl:Class ;
    rdfs:label "Actor" ;
    skos:definition "An object that is either a person or an organisation" ;
    skos:note "It roughly corresponds to the legal concept of a legal person" ;
    owl:disjointUnionOf ( loze:Person loze:Organisation ) .


##############
# Membership #
##############

loze:Membership a owl:Class ;
    rdfs:label "Membership" ;
    skos:definition "An eventuality that consists in an actor being part of a group by joining its goals or activities" ;
    skos:example "A person being a member of a household, a person being a member of a club or charity, a person being an employee of a company, a company being a member of a trade group, France being a member of the European Union" ;
    skos:note "In a membership, the main participants are the actor that is the member (loze:isMemberIn) and the group of which they are a member (loze:isSettingIn)" ;
    rdfs:subClassOf loze:Eventuality . 

loze:isMemberIn a owl:ObjectProperty ;
    rdfs:label "is Member In" ;
    skos:definition "The relation that obtains between an actor and a membership if and only if the actor joins the activities of a group in the context of that membership" ;
    skos:example "In the case of the membership of France in the European Union, France is the member; " ;
    skos:note "The group of which an actor is the member is the setting (loze:isSettingIn) in the context of the relevant membership" ;
    rdfs:domain loze:Actor ;
    rdfs:range loze:Group ;
    rdfs:subPropertyOf loze:isParticipantIn .

loze:hasMember a owl:ObjectProperty ;
    rdfs:label "has Member" ;
    skos:definition "The relation that obtains between a membership and an actor if and only if the actor joins the activities of a group in the context of that membership" ;
    rdfs:domain loze:Group ;
    rdfs:range loze:Actor ;
    owl:inverseOf loze:isMemberIn .