@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loze: <https://loze-ontology.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://loze-ontology.org/materials-and-composition> a owl:Ontology ;
    rdfs:label "Materials and Composition" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "An extension of loze-foundation.ttl that consists of classes and relations intended for the modelling substances and material composition" ;
    owl:imports loze: .

#############################
# Materials and Composition #
#############################

loze:Substance a owl:Class ;
    rdfs:label "Substance" ;
    skos:definition "A schematic particular that (i) is either an object or an aggregate and (ii) is highly dissectable" ;
    skos:example "Copper, gold, water, wood, kerosene, steel, wheat flour, sugar, liquid acrylic paint" ;
    skos:note "Dissectability consists in the concretizations of a schematic particular being iteratively divisible into parts of the same kind: a mass of water can be divided into other masses of water; a chunk of wood can be further divided into other chunks of wood; a piece of gold can be divided into smaller pieces of gold; and so on. Despite the appearance of infinite divisibility, we know from chemistry that this dissectability stops at either the molecular or the atomic level: for example, a water molecule has no smaller parts that are themselves water, and an atom of gold has no smaller parts that are themselves gold" ;
    skos:note "Here the word 'substance' is used in the chemical sense, not in the metaphysical sense - which originated in ancient Greek philosophy and is still used in contemporary analytic metaphysics" ;
    rdfs:subClassOf loze:SchematicParticular, [ a owl:Class ; 
                                                owl:unionOf ( loze:Object loze:Aggregate ) ].

loze:isRepeatedComponentIn a owl:ObjectProperty ;
    rdfs:label "is Repeated Component In" ;
    skos:definition "The sub-relation of loze:isComponentIn that obtains whenever the component is a schematic particular that is repeated in the composite in multiple occurrences" ;
    skos:example "In the case of a monomer making up a polymer chain, the monomer is the repeated component; in the case of water having two atoms of hydrogen, hydrogen atom is the repeated component; in the case of an engine having pistons of a certain type, the piston - construed as a schematic object - is the repeated component" ;
    skos:note "While the repeated component is always a schematic particular, the composite can be either a schematic particular or a concrete particular" ;
    skos:note "The number of repetitions is specified by the associated number of occurrences (loze:hasNumberOfOccurrences)" ;
    rdfs:domain loze:SchematicParticular ;
    rdfs:range loze:Composition ;
    rdfs:subPropertyOf loze:isComponentIn .

loze:hasRepeatedComponent a owl:ObjectProperty ;
    rdfs:label "has Repeated Component" ;
    skos:definition "The relation that obtains between a composition c and a schematic particular s if and only if s is the repeated component in c" ;
    rdfs:domain loze:Composition ;
    rdfs:range loze:SchematicParticular ;
    owl:inverseOf loze:isRepeatedComponentIn .

loze:isIngredientIn a owl:ObjectProperty ;
    rdfs:label "is Ingredient In" ;
    skos:definition "The sub-relation of loze:isComponentIn that obtains whenever the component is a substance that occurs in the composite in a given amount" ;
    skos:example "In the case of a cake having as ingredient 200 grams of wheat flour, wheat flour is the ingredient; in the case of a solution having as ingredient 2 litres of water, water is the ingredient" ;
    skos:note "Substance repetition is impractical to account for in terms of number of occurrences, since the units are too many to be counted; consequently, instead of using loze:hasNumberOfOccurrences, it is advisable to specify quantities based on units of measure" ;
    rdfs:domain loze:Substance ;
    rdfs:range loze:Composition ;
    rdfs:subPropertyOf loze:isComponentIn .

loze:hasIngredient a owl:ObjectProperty ;
    rdfs:label "has Ingredient" ;
    skos:definition "The relation that obtains between a composition c and a substance s if and only if s is the ingredient in c" ;
    rdfs:domain loze:Composition ;
    rdfs:range loze:Substance ;
    owl:inverseOf loze:isIngredientIn .

loze:isRepeatedContentIn a owl:ObjectProperty ;
    rdfs:label "is Repeated Content In" ;
    skos:definition "The sub-relation of loze:isContentIn that obtains whenever the content is a schematic particular that is repeated in the host in multiple occurrences" ;
    skos:example "In the case of a blister pack containing 10 standardised 5 mg paracetamol tablets, the 5 mg paracetamol tablet - construed as a schematic particular - is the repeated content" ;
    skos:note "While the repeated content is always a schematic particular, the host can be either a schematic particular or a concrete particular" ;
    skos:note "A containment with a repeated component always has an associated number of occurrences (loze:hasNumberOfOccurrences)" ;
    rdfs:domain loze:SchematicParticular ;
    rdfs:range loze:Containment ;
    rdfs:subPropertyOf loze:isContentIn .

loze:hasRepeatedContent a owl:ObjectProperty ;
    rdfs:label "has Repeated Content" ;
    skos:definition "The relation that obtains between a containment c and a schematic particular s if and only if s is the repeated content in c" ;
    rdfs:domain loze:Containment ;
    rdfs:range loze:SchematicParticular ;
    owl:inverseOf loze:isRepeatedContentIn .

loze:hasNumberOfOccurrences a owl:DatatypeProperty ;
    rdfs:label "has Number Of Occurrences" ;
    skos:definition "The relation that assigns to an eventuality the number of occurrences in which a certain schematic particular is repeated in the context of that eventuality" ;
    skos:example "In a composition in which a polymer chain has a monomer repeated 3000 times, the number of occurrences is 3000; in the composition of the water molecule out of hydrogen, the number of occurrences is 2; in a containment in which a tablet is repeated 10 times in a blister pack, the number of occurrences is 10" ;
    skos:note "This relation is mostly intended to be used in the context of compositions (loze:Composition) and containments (loze:Containment); that being said, its application to other eventualities should not be excluded in principle" ;
    rdfs:domain loze:Eventuality ;
    rdfs:range xsd:nonNegativeInteger .